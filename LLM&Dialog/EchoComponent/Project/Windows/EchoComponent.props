<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
    <EchoSDK>..\..\..\EchoSDK</EchoSDK>
    <TargetOS>Windows</TargetOS>
  </PropertyGroup>
  <PropertyGroup />
  <ItemDefinitionGroup />
  <ItemGroup>
    <BuildMacro Include="EchoSDK">
      <Value>$(EchoSDK)</Value>
    </BuildMacro>
    <BuildMacro Include="TargetOS">
      <Value>$(TargetOS)</Value>
    </BuildMacro>
  </ItemGroup>
</Project>